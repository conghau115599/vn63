{
  "schemaVersion": "1.2.0",
  "dateSystem": "gregorian",
  "locale": "vi-VN",
  "calendarTimezone": "Asia/Ho_Chi_Minh",
  "simulationStep": "calendar_month",
  "timeUnits": { "daysPerWeek": 7, "minutesPerDay": 1440, "hoursPerWeek": 168 },
